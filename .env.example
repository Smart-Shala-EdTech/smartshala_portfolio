# SmartShala Marketing Site Environment Configuration
# Copy this file to .env.local for local development.
# Never commit real secrets or production credentials to git.

# -----------------------------------------------------------------------------
# SMTP Email Delivery (Required for Contact Form in Phase 1)
# -----------------------------------------------------------------------------
# If any of these are missing, the contact API returns HTTP 500 and guides the
# user to WhatsApp or direct email.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
CONTACT_TO_EMAIL="info@smartshala.net"
CONTACT_FROM_EMAIL="leads@smartshala.net"

# -----------------------------------------------------------------------------
# Optional Meeting Booking Link (Phase 1)
# -----------------------------------------------------------------------------
# If unset, the Calendly button is omitted completely.
NEXT_PUBLIC_CALENDLY_URL=""

# -----------------------------------------------------------------------------
# Canonical Site URL (Required for Phase 6 SEO, Open Graph, Sitemap, Robots)
# -----------------------------------------------------------------------------
# Set this to the live domain (e.g. https://smartshala.net).
# Do not leave empty in production.
NEXT_PUBLIC_SITE_URL="https://smartshala.net"

# -----------------------------------------------------------------------------
# Direct Phone Number (Phase 4 / Phase 6)
# -----------------------------------------------------------------------------
# Optional direct phone number for call buttons (e.g. "+917408859799").
# If unset, call buttons in footer and sticky mobile bar are omitted.
NEXT_PUBLIC_PHONE=""

# -----------------------------------------------------------------------------
# Service Area Geography (Phase 4 / Phase 7)
# -----------------------------------------------------------------------------
# Optional geographical focus (e.g. "Kanpur, Delhi NCR & across India").
# If unset, region-specific lines are omitted.
NEXT_PUBLIC_SERVICE_AREA=""

# -----------------------------------------------------------------------------
# Google Analytics 4 (Phase 6)
# -----------------------------------------------------------------------------
# Optional Google Analytics 4 measurement ID (e.g. "G-XXXXXXXXXX").
# If unset, no Google Analytics scripts or cookies are loaded.
NEXT_PUBLIC_GA_ID=""

# -----------------------------------------------------------------------------
# Google Search Console Verification (Phase 6)
# -----------------------------------------------------------------------------
# Optional verification code for Google Search Console meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=""

# -----------------------------------------------------------------------------
# Physical Business Address (Phase 6 LocalBusiness Schema)
# -----------------------------------------------------------------------------
# Optional structured address. If unset, physical address is omitted from JSON-LD.
NEXT_PUBLIC_ADDRESS_STREET=""
NEXT_PUBLIC_ADDRESS_LOCALITY=""
NEXT_PUBLIC_ADDRESS_REGION=""
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=""
NEXT_PUBLIC_ADDRESS_COUNTRY="IN"
